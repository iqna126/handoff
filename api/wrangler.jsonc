{
  // 结构照抄 cloudflare/python-workers-examples 的 fastapi 示例（第一版手写的缺了
  // python_dedicated_snapshot 这个 flag，也没有配套的 package.json，会导致依赖装不上）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handoff",
  "main": "src/worker.py",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["python_workers", "python_dedicated_snapshot"],
  "observability": {
    "enabled": true,
  },
  // ALERT_EMAIL 不是密钥（就是个收告警邮件的地址），进仓库没问题——
  // RESEND_API_KEY/SUPABASE_SERVICE_KEY/WODIFY_SYNC_TOKEN 这些真密钥
  // 绝不能写在这里，只能用 `wrangler secret put`（见 CLAUDE.md 密钥清单）
  "vars": {
    "ALERT_EMAIL": "irisssaq@gmail.com",
  },
  "triggers": {
    // 独立存活校验（DESIGN.md §6.6）。Cloudflare Cron Trigger 只认 UTC，不会跟着
    // 场馆时区走（不像 Oracle 那台机器专门设过 America/Los_Angeles）——之前随手
    // 填的 "0 5 * * *" 相当于太平洋时间前一天晚上 10 点左右，"检查今天有没有
    // WOD"这件事在那个点上按当地时间算"今天"根本还没开始，没有意义。
    //
    // 现在改成 11:00 UTC，对应太平洋时间凌晨 4 点（PDT，夏令时）或凌晨 3 点
    // （PST，冬令时）——Cloudflare 的 cron 不会跟着夏令时自动切换，固定一个值
    // 两季都够用（PST 时只是提前一小时查，更早不算坏事）。真机抓到的最早排课
    // 是早上 6 点（见 wods.class_times），这个点位在 wodify-pull 周一凌晨 3 点
    // 的抓取之后、最早一节课之前留了 2-3 小时人工处理的缓冲，不是刚好卡点。
    "crons": ["0 11 * * *"],
  },
}
